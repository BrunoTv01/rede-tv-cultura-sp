# Opcional. Copie para .env só se quiser mudar algo.
# Senha inicial do usuário admin (8+ caracteres, letras e números). Vazio = "admin" (troca exigida no 1º acesso).
ADMIN_TOKEN=
# Porta do sistema
PORT=3100
# Senha interna do banco (o banco não fica exposto fora do Docker)
DB_PASSWORD=
# Opcional: leitura do painel "Manutenções Rede" do Grafana (também dá para configurar pela página, menu Manutenções)
GRAFANA_URL=
GRAFANA_TOKEN=
GRAFANA_DASHBOARD=
GRAFANA_PANEL=
# Opcional: estações no ar, do "Dashboard Estações" do Grafana (token de conta de serviço, perfil Viewer)
TELEMETRIA_URL=
TELEMETRIA_TOKEN=
TELEMETRIA_DASHBOARD=
